# Rust build output (keep Cargo.lock tracked)
debug/
target/

# Frontend dependencies, builds, caches, and test reports
node_modules/
dist/
.vite/
.cache/
coverage/

# Generated wasm-pack bindings (keep authored WASM and 3D assets tracked)
/crates/crypto-wasm/pkg/

# Local environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*~

# Compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.7z
*.rar

# Operating system metadata and Blender backup files
.DS_Store
Thumbs.db
*.blend1
*.blend2

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Local JetBrains IDE configuration
.idea/
